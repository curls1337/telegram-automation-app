<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Telegram Automation' %></title>
  <style nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f7f8fa;
      color: #333;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .app-layout {
      display: flex;
      flex: 1;
    }
    .main-content {
      flex: 1;
      padding: 1.5rem 2rem;
      overflow-y: auto;
    }
    a { color: #3182ce; text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <%- include('../partials/nav') %>

  <div class="app-layout">
    <%- include('../partials/sidebar') %>

    <main class="main-content">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  </div>

  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    // Locale switcher handler
    document.addEventListener('DOMContentLoaded', function() {
      var switcher = document.getElementById('locale-switcher');
      if (switcher) {
        switcher.addEventListener('change', function() {
          window.location.href = '/settings/language?lang=' + this.value;
        });
      }
    });
  </script>
</body>
</html>
