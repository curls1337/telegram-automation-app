<% if (typeof flash !== 'undefined' && flash) { %>
  <% if (flash.success) { %>
    <div style="background: #c6f6d5; border: 1px solid #9ae6b4; color: #22543d; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem;">
      <%= flash.success %>
    </div>
  <% } %>
  <% if (flash.error) { %>
    <div style="background: #fed7d7; border: 1px solid #feb2b2; color: #742a2a; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem;">
      <%= flash.error %>
    </div>
  <% } %>
  <% if (flash.info) { %>
    <div style="background: #bee3f8; border: 1px solid #90cdf4; color: #2a4365; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem;">
      <%= flash.info %>
    </div>
  <% } %>
<% } %>
