<% var title = typeof t === 'function' ? t('auth.forgot.title') : 'Forgot Password'; %>

<h1 class="auth-title"><%= typeof t === 'function' ? t('auth.forgot.title') : 'Forgot Password' %></h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error-msg"><%= error %></div>
<% } %>

<% if (typeof success !== 'undefined' && success) { %>
  <div style="background: #c6f6d5; border: 1px solid #9ae6b4; color: #22543d; padding: 0.5rem 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.85rem;">
    <%= success %>
  </div>
<% } %>

<p style="font-size: 0.875rem; color: #4a5568; margin-bottom: 1rem;">
  <%= typeof t === 'function' ? t('auth.forgot.description') : 'Enter your email address and we will send you a link to reset your password.' %>
</p>

<form action="/forgot-password" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="form-group">
    <label for="email"><%= typeof t === 'function' ? t('auth.email') : 'Email' %></label>
    <input type="email" id="email" name="email" required autocomplete="email"
           value="<%= typeof email !== 'undefined' ? email : '' %>">
  </div>

  <button type="submit" class="btn-primary">
    <%= typeof t === 'function' ? t('auth.forgot.submit') : 'Send Reset Link' %>
  </button>
</form>

<div class="auth-links">
  <a href="/login"><%= typeof t === 'function' ? t('auth.forgot.loginLink') : 'Back to login' %></a>
</div>
