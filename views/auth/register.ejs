<% var title = typeof t === 'function' ? t('auth.register.title') : 'Register'; %>

<h1 class="auth-title"><%= typeof t === 'function' ? t('auth.register.title') : 'Register' %></h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error-msg"><%= error %></div>
<% } %>

<form action="/register" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="form-group">
    <label for="name"><%= typeof t === 'function' ? t('auth.name') : 'Name' %></label>
    <input type="text" id="name" name="name" required autocomplete="name"
           value="<%= typeof name !== 'undefined' ? name : '' %>">
  </div>

  <div class="form-group">
    <label for="email"><%= typeof t === 'function' ? t('auth.email') : 'Email' %></label>
    <input type="email" id="email" name="email" required autocomplete="email"
           value="<%= typeof email !== 'undefined' ? email : '' %>">
  </div>

  <div class="form-group">
    <label for="password"><%= typeof t === 'function' ? t('auth.password') : 'Password' %></label>
    <input type="password" id="password" name="password" required autocomplete="new-password"
           minlength="8">
    <small style="color: #718096; font-size: 0.75rem;">
      <%= typeof t === 'function' ? t('auth.register.passwordHint') : 'Min 8 characters, at least 1 letter and 1 number' %>
    </small>
  </div>

  <button type="submit" class="btn-primary">
    <%= typeof t === 'function' ? t('auth.register.submit') : 'Register' %>
  </button>
</form>

<div class="auth-links">
  <a href="/login"><%= typeof t === 'function' ? t('auth.register.loginLink') : 'Already have an account? Login' %></a>
</div>
