<%- include('../partials/flash') %>

<div class="container mx-auto px-4 py-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold"><%= title %></h1>
    <a href="/auto-reply/new" class="btn btn-primary">
      + New Rule
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error mb-4">
      <p><%= error %></p>
    </div>
  <% } %>

  <% if (rules.length === 0) { %>
    <div class="text-center py-12 text-gray-500">
      <p>No auto-reply rules yet.</p>
      <p class="mt-2">
        <a href="/auto-reply/new" class="text-blue-600 underline">Create your first rule</a>
      </p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="table w-full">
        <thead>
          <tr>
            <th>Priority</th>
            <th>Trigger</th>
            <th>Value</th>
            <th>Connection</th>
            <th>Case Sensitive</th>
            <th>Active</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% rules.forEach(function(rule) { %>
            <tr>
              <td><%= rule.priority %></td>
              <td>
                <span class="badge badge-outline"><%= rule.trigger_kind %></span>
              </td>
              <td>
                <code class="text-sm"><%= rule.trigger_value.length > 40 ? rule.trigger_value.substring(0, 40) + '...' : rule.trigger_value %></code>
              </td>
              <td>
                <% if (rule.connection_id) { %>
                  <% var conn = connections.find(function(c) { return c.id === rule.connection_id; }); %>
                  <%= conn ? conn.display_name : 'Unknown' %>
                <% } else { %>
                  <em>All connections</em>
                <% } %>
              </td>
              <td><%= rule.case_sensitive ? 'Yes' : 'No' %></td>
              <td>
                <form method="POST" action="/auto-reply/<%= rule.id %>/toggle" style="display:inline;">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken === 'function' ? csrfToken() : '' %>">
                  <input type="hidden" name="is_active" value="<%= rule.is_active ? 'false' : 'true' %>">
                  <button type="submit" class="badge <%= rule.is_active ? 'badge-success' : 'badge-error' %> cursor-pointer">
                    <%= rule.is_active ? 'Active' : 'Inactive' %>
                  </button>
                </form>
              </td>
              <td>
                <a href="/auto-reply/<%= rule.id %>/edit" class="btn btn-sm btn-ghost">Edit</a>
                <form method="POST" action="/auto-reply/<%= rule.id %>/delete" style="display:inline;">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken === 'function' ? csrfToken() : '' %>">
                  <button type="submit" class="btn btn-sm btn-error btn-ghost"
                    onclick="return confirm('Are you sure you want to delete this rule?')">
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
