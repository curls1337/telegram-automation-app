<% var title = typeof t === 'function' ? t('auth.invitation.title') : 'Accept Invitation'; %>

<h1 class="auth-title"><%= typeof t === 'function' ? t('auth.invitation.title') : 'Accept Invitation' %></h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error-msg"><%= error %></div>
<% } %>

<% if (typeof invitation !== 'undefined' && invitation) { %>
  <p style="font-size: 0.875rem; color: #4a5568; margin-bottom: 1rem;">
    <%= typeof t === 'function' ? t('auth.invitation.description', { tenant: invitation.tenantName || '' }) : 'You have been invited to join a team. Set your password to accept.' %>
  </p>
<% } %>

<form action="/invitations/<%= token %>" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="form-group">
    <label for="password"><%= typeof t === 'function' ? t('auth.password') : 'Password' %></label>
    <input type="password" id="password" name="password" required autocomplete="new-password"
           minlength="8">
    <small style="color: #718096; font-size: 0.75rem;">
      <%= typeof t === 'function' ? t('auth.register.passwordHint') : 'Min 8 characters, at least 1 letter and 1 number' %>
    </small>
  </div>

  <button type="submit" class="btn-primary">
    <%= typeof t === 'function' ? t('auth.invitation.submit') : 'Accept & Set Password' %>
  </button>
</form>

<div class="auth-links">
  <a href="/login"><%= typeof t === 'function' ? t('auth.invitation.loginLink') : 'Already have an account? Login' %></a>
</div>
