# =============================================================================
# Telegram Automation App — Environment Variables (.env.example)
# =============================================================================
# Copy this file to `.env` and fill the values for local development.
# In production (Sevalla.com), set every variable in the App's env section.
#
# Validation lives in `src/shared/env.js` (Zod schema). The process exits with
# a non-zero code at boot when required values are missing or invalid.
# Reference: requirements.md §21.2, design.md "Environment Variables".
# -----------------------------------------------------------------------------

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=8080
# Public base URL of the dashboard / API (used in invitation & reset emails).
BASE_URL=http://localhost:8080
# Express `trust proxy` setting. Use `1` behind a single proxy (Sevalla edge),
# or values supported by Express (e.g. `loopback`, `linklocal`, IP list).
TRUST_PROXY=1
LOG_LEVEL=info

# ---- Database (PostgreSQL) --------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tgapp
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Session ----------------------------------------------------------------
# Random ≥32-char secret used to sign session cookies.
# Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# ---- Encryption (AES-256-GCM master keys) -----------------------------------
# Both keys MUST decode from base64 to exactly 32 bytes (256 bits).
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
APP_MASTER_KEY=
# Optional previous key used during rotation; leave empty when no rotation in flight.
APP_MASTER_KEY_PREV=
# Identifier of the active key (stored on each ciphertext blob for rotation lookups).
APP_MASTER_KEY_ID=v1

# ---- Object Storage (S3-compatible: Sevalla Object Storage / R2 / S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tgapp-dev

# ---- SMTP (transactional email) ---------------------------------------------
# Format: smtp://user:pass@host:port  or  smtps://user:pass@host:port
SMTP_URL=smtp://user:pass@localhost:1025
MAIL_FROM=no-reply@example.com

# ---- Google Gemini (optional; required only when AI auto-reply is used) -----
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ---- Super Admin bootstrap (consumed by `npm run seed`) ---------------------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=changeme-min-8-with-letters-and-digits-1

# ---- Concurrency & limits ---------------------------------------------------
WEB_CONCURRENCY=1
WORKER_CONCURRENCY_DEFAULT=5
RATE_LIMIT_LOGIN_MAX=5
BACKUP_PASSPHRASE_PBKDF2_ITERS=200000

# ---- Observability (optional) -----------------------------------------------
# Enable Prometheus `/metrics` endpoint. Accepts: 1, true, yes, on.
METRICS_ENABLED=0
